// Zed keymap — leader-key style bindings mirroring the <leader> scheme in
// init.lua (space as leader). Install to ~/.config/zed/keymap.json.
//
// NOTE ON CONFIDENCE: Zed's action names can shift between releases, and
// a couple of the panel-toggle actions below (git_panel, outline_panel)
// are less consistently documented than the core editor/LSP ones. If a
// binding silently does nothing: open the Command Palette (cmd-shift-p),
// find the command by name/description there (it shows the actual action
// id), and swap the correct id in below. Don't assume the binding is
// broken by design — it's almost always just a renamed action.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      // File nav — mirrors <leader>e / <leader>ff / <leader>fg in init.lua
      "space e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",

      // Git — mirrors <leader>gs/gb/gd in init.lua
      "space g s": "git_panel::ToggleFocus",
      "space g d": "editor::ToggleGitBlameInline",

      // LSP — same intent as the LspAttach keymaps in init.lua
      // (gd/gr/K/<leader>rn/<leader>ca are already native vim-mode
      // defaults in Zed, so they're not rebound here on purpose)
      "space c a": "editor::ToggleCodeActions",
      "space c d": "diagnostics::Deploy",

      // Outline (tagbar/aerial equivalent)
      "space t t": "outline_panel::ToggleFocus",

      // Splits — mirrors <leader>sv/sh in init.lua
      "space s v": "pane::SplitRight",
      "space s h": "pane::SplitDown",

      // Buffers — mirrors <leader>bd/bn/bp in init.lua
      "space b d": "pane::CloseActiveItem",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePrevItem",

      // Search highlight clear — mirrors <leader>/ in init.lua
      "space /": "editor::ClearSearchHighlights",

      // Save / quit — mirrors <leader>w/q in init.lua
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",

      // Terminal — no direct init.lua equivalent, added since tmux lives
      // in the terminal panel now
      "space `": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Move line up/down — mirrors <A-j>/<A-k> in init.lua
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  }
]
