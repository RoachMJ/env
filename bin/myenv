#!/usr/bin/env bash
# ------------------------------------------------------------------
# myenv — status/update CLI for the MyEnv three-repo install
# (env, env-personal, env-professional, all under ~/.env-config).
#
# v1, deliberately plain bash — this is the MVP version of what's
# meant to eventually become a real Go binary (see the "Go migration"
# epic in release-planning/issues/005-epic-go-migration.md) once the
# broader component-registry redesign lands. Until then, this covers
# the concrete, urgent need it was built for: noticing a new branch or
# unpulled changes on a repo and asking what to do about it, instead
# of silently doing nothing (the actual incident that prompted this —
# see release-planning/issues/010-cli-repo-state-awareness.md).
#
# Subcommands:
#   myenv status    read-only: branch, last commit, version state for
#                   every repo (fetches first, never writes/merges)
#   myenv update [branch]
#                   fetch every repo, show ONLY what's new (new branches,
#                   branch/tag updates on ANY local branch with an
#                   upstream — not just whichever one's checked out), then
#                   one menu: update everything, or pick per repo. Nothing
#                   new -> says so, no prompts. Pass a branch name to
#                   scope to just that branch across all three repos.
#   myenv version   one-line version summary per repo (for scripting/
#                   piping — no color, no prompts)
#   myenv link      re-sync ONLY what's already installed — reads
#                   install-manifest.jsonl to find which items a real
#                   install actually selected per profile, then re-runs
#                   just those via install.sh --only=<items>. Never
#                   selects everything, never installs anything new.
#                   Picks up any NEW symlink/config-sync call a `git
#                   pull`/branch checkout brought in (e.g. a new
#                   codex/rules/ dir) for items you already have,
#                   without re-walking every package install prompt.
#                   No manifest entries for a profile -> skipped with a
#                   pointer to run that profile's install.sh yourself
#                   once. Does not touch the env bootstrap repo — its
#                   one symlink (bin/myenv) is already in place if
#                   you're running this.
#   myenv help      this text
#
# "Version state": if the current HEAD is exactly a tagged commit,
# that tag is the version, shown as stable. If HEAD is ahead of the
# latest tag by any number of commits, that's flagged EXPERIMENTAL —
# real but not yet released. No tags at all -> "dev".
# ------------------------------------------------------------------
set -euo pipefail

ENVCFG_HOME="${ENVCFG_HOME:-$HOME/.env-config}"
REPOS=(env env-personal env-professional)

# ---- color (real ANSI, same idea as the MyEnv install banner — off
# automatically when not writing to a terminal, e.g. piped into a file
# or another command) ----
if [[ -t 1 ]]; then
  c_reset=$'\033[0m'; c_bold=$'\033[1m'; c_dim=$'\033[2m'
  c_green=$'\033[38;2;147;163;95m'; c_amber=$'\033[38;2;217;181;104m'
  c_red=$'\033[38;2;192;82;58m'; c_blue=$'\033[38;2;91;107;122m'
else
  c_reset=""; c_bold=""; c_dim=""; c_green=""; c_amber=""; c_red=""; c_blue=""
fi

say()    { printf '%s\n' "$*"; }
header() { printf '\n%s%s%s\n' "$c_bold" "$*" "$c_reset"; }
warn()   { printf '%s%s%s\n' "$c_amber" "$*" "$c_reset" >&2; }

usage() {
  cat <<'EOF'
myenv — status/update CLI for the MyEnv install

Usage:
  myenv status         show branch/commit/version state for every repo (read-only)
  myenv update [branch]
                       fetch every repo, then show ONLY what's actually new:
                       new branches on origin, and local branches (any of
                       them, not just whichever one's checked out) whose
                       upstream has commits/tags they don't have yet. If
                       nothing's new, says so and exits — no prompts.
                       Otherwise asks once: update everything found, or go
                       repo-by-repo and pick exactly what to do per repo
                       (Enter always means "leave this repo alone").
                       Pass a branch name to scope everything to just that
                       one branch across all repos.
  myenv version        one-line version summary per repo (no color, no prompts)
  myenv link           re-sync ONLY items already installed (reads
                       install-manifest.jsonl per profile, re-runs just
                       those via install.sh --only=...) — use after a
                       git pull/checkout brings in a new symlinked file.
                       Never selects or installs anything you didn't
                       already have.
  myenv help           show this help

Repos checked (under ENVCFG_HOME, default ~/.env-config):
  env, env-personal, env-professional
EOF
}

repo_dir() { printf '%s/%s' "$ENVCFG_HOME" "$1"; }

# Filter REPOS down to only what's actually cloned on THIS machine.
# install.sh lets you install just one profile (env + env-personal only
# is a completely normal setup — e.g. a personal laptop with no
# professional profile at all), so unconditionally looping the full
# env/env-personal/env-professional list and printing a "not cloned"
# placeholder for whatever wasn't chosen meant every status/update/
# version run showed that noise forever, on every machine that isn't
# running all three. Checked once, here, right after repo_dir() is
# defined (needs it) and before any command runs — every command below
# just naturally only ever sees repos that exist; no per-command
# "if not cloned" branch left to keep in sync with this one.
# Built as a normal array, then reassigned to REPOS with the
# "${arr[@]+"${arr[@]}"}" form rather than plain "${arr[@]}" — same
# macOS-bash-3.2 empty-array issue as everywhere else in this script
# (see the token_args comment in env/install.sh's clone_or_pull_profile
# for the full explanation): under `set -u`, 3.2 treats a *zero-element*
# array as unset, so a plain "${_present[@]}" would hard-exit here on
# any machine with only one profile installed — the exact case this
# whole filter exists to handle cleanly.
_present=()
for _r in "${REPOS[@]}"; do
  [[ -d "$(repo_dir "$_r")/.git" ]] && _present+=("$_r")
done
REPOS=("${_present[@]+"${_present[@]}"}")
unset _present _r

# Guard for the (rare) case NOTHING was found — misconfigured
# ENVCFG_HOME, or this got run before any profile's install.sh ever
# ran. Every cmd_* below calls this first so an empty REPOS produces
# one clear message instead of a silent no-op loop.
_require_repos() {
  if (( ${#REPOS[@]} == 0 )); then
    echo "myenv: no repos found under $ENVCFG_HOME (looked for: env, env-personal, env-professional)." >&2
    echo "Run this profile's install.sh first, or check that ENVCFG_HOME is set correctly." >&2
    return 1
  fi
  return 0
}

# version_state <repo-dir> -> prints "LABEL|detail", e.g.
#   stable|v1.0.0
#   experimental|v1.0.0 +3 commits
#   dev|no tags yet
version_state() {
  local dir="$1" last_tag tag_commit head_commit ahead
  last_tag="$(git -C "$dir" describe --tags --abbrev=0 2>/dev/null || true)"
  if [[ -z "$last_tag" ]]; then
    printf 'dev|no tags yet\n'
    return 0
  fi
  tag_commit="$(git -C "$dir" rev-list -n1 "$last_tag" 2>/dev/null || true)"
  head_commit="$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)"
  if [[ "$tag_commit" == "$head_commit" ]]; then
    printf 'stable|%s\n' "$last_tag"
  else
    ahead="$(git -C "$dir" rev-list --count "${last_tag}..HEAD" 2>/dev/null || echo '?')"
    printf 'experimental|%s +%s commit(s)\n' "$last_tag" "$ahead"
  fi
}

# branches_behind <repo-dir> [only-branch] -> "branch:behind-count" per
# line, for every local branch that has an upstream and is behind it.
# If only-branch is given, filters to just that one (if it exists
# locally with an upstream at all).
branches_behind() {
  local dir="$1" only="${2:-}"
  local b upstream behind
  while read -r b upstream; do
    [[ -z "$b" || -z "$upstream" ]] && continue
    [[ -n "$only" && "$b" != "$only" ]] && continue
    behind="$(git -C "$dir" rev-list --count "${b}..${upstream}" 2>/dev/null || echo 0)"
    (( behind > 0 )) && printf '%s:%s\n' "$b" "$behind"
  done < <(git -C "$dir" for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads)
  return 0
}

# _read_lines < <(cmd) -> fills _read_lines_result (a plain global, not
# passed by name). Portable stand-in for `mapfile -t arr < <(cmd)` — macOS
# ships bash 3.2 as /bin/bash (last GPLv2 release, still the default on
# every Mac) and 3.2 has neither mapfile (added in bash 4.0) nor nameref
# variables (declare -n, added in 4.3), so a name-parameterized helper
# isn't possible here; callers read the fixed-name result array back out
# instead. Blank lines are dropped so `(( ${#arr[@]} > 0 ))` checks behave
# the same as they would against a real empty command output.
_read_lines() {
  _read_lines_result=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && _read_lines_result+=("$line")
  done
}

# new_remote_branches <repo-dir> <current-branch> -> one branch name per
# line, remote branches with no matching local branch (excludes HEAD/
# symbolic refs)
new_remote_branches() {
  local dir="$1"
  local -a remote_names local_names
  # Deliberately NOT piping for-each-ref through sed/grep to strip the
  # "origin/" prefix and drop HEAD — a stray/leftover ref under
  # refs/remotes/origin that's literally named "origin" (no slash, no
  # branch component — seen in the wild, root cause unconfirmed but
  # real) sailed straight through that pipeline: sed's 's#^origin/##'
  # only strips when "origin/" is actually a prefix, so a bare "origin"
  # entry passed through unchanged, wasn't "HEAD", and got printed as a
  # fake "new branch" with no actual branch name. Doing the prefix
  # check explicitly in bash below means anything that ISN'T shaped
  # like "origin/<branch>" is skipped outright instead of silently
  # surviving as garbage.
  _read_lines < <(git -C "$dir" for-each-ref --format='%(refname:short)' refs/remotes/origin || true)
  remote_names=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")
  _read_lines < <(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads || true)
  local_names=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")
  local r stripped l found
  for r in "${remote_names[@]:-}"; do
    [[ -z "$r" ]] && continue
    case "$r" in
      origin/*) stripped="${r#origin/}" ;;
      *) continue ;;
    esac
    [[ -z "$stripped" || "$stripped" == "HEAD" ]] && continue
    found=0
    for l in "${local_names[@]:-}"; do
      [[ "$stripped" == "$l" ]] && { found=1; break; }
    done
    (( found == 0 )) && printf '%s\n' "$stripped"
  done
}

print_repo_status() {
  local repo="$1" dir branch last_commit state label detail
  dir="$(repo_dir "$repo")"
  header "== $repo =="
  # No "not cloned" branch here anymore — $repo only ever comes from the
  # pre-filtered REPOS (see the top of this file), so $dir/.git is
  # guaranteed to exist by the time this function runs.
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  last_commit="$(git -C "$dir" log -1 --format='%h %s (%cr)' 2>/dev/null || echo '?')"
  state="$(version_state "$dir")"
  label="${state%%|*}"
  detail="${state#*|}"

  say "  Branch:       $branch"
  say "  Last commit:  $last_commit"
  case "$label" in
    stable)       say "  Version:      ${c_green}${detail} (stable)${c_reset}" ;;
    experimental) say "  Version:      ${c_amber}${detail} (experimental — untagged)${c_reset}" ;;
    dev)          say "  Version:      ${c_amber}dev (${detail})${c_reset}" ;;
  esac

  # ahead/behind vs origin/<branch>, only if that remote branch exists
  if git -C "$dir" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
    local ahead_local behind_local
    ahead_local="$(git -C "$dir" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
    behind_local="$(git -C "$dir" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
    if (( behind_local > 0 )); then
      say "  Upstream:     ${c_amber}${behind_local} new commit(s) on origin/${branch} not pulled yet${c_reset}"
    fi
    if (( ahead_local > 0 )); then
      say "  Upstream:     ${c_dim}${ahead_local} local commit(s) not pushed yet${c_reset}"
    fi
  fi

  local -a new_branches
  _read_lines < <(new_remote_branches "$dir" "$branch")
  new_branches=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")
  if (( ${#new_branches[@]} > 0 )); then
    say "  ${c_red}New branch(es) on origin not seen locally:${c_reset}"
    for b in "${new_branches[@]}"; do
      say "    - $b"
    done
  fi
}

cmd_status() {
  _require_repos || return 1
  for repo in "${REPOS[@]}"; do
    local dir; dir="$(repo_dir "$repo")"
    git -C "$dir" fetch --quiet 2>/dev/null || true
    print_repo_status "$repo"
  done
  say ""
}

cmd_version() {
  _require_repos || return 1
  for repo in "${REPOS[@]}"; do
    local dir state
    dir="$(repo_dir "$repo")"
    state="$(version_state "$dir")"
    printf '%s: %s\n' "$repo" "${state#*|}"
  done
}

# Re-sync symlinks/configs for whatever's ALREADY installed — never
# selects everything, never installs anything new. install.sh's own
# install-manifest.jsonl (one file, shared across profiles, each line
# tagged "profile":"<profile>","item":"<item-key>" in that fixed order —
# same file lib/common.sh's manifest_has_item() already reads) is the
# single source of truth for "which items did a real install actually
# choose on this machine" — this greps that file for the current
# profile's distinct item keys and passes them straight through as
# install.sh --only=<keys>, so a repo where you only ever selected
# neovim+zshrc+git only ever re-syncs neovim+zshrc+git, never the other
# nine items you deliberately left unchecked. install.sh's own
# per-package/per-symlink idempotency (install_pkg_one checks before
# installing; link_file/sync_config_overlay no-op when already correct)
# is what makes this cheap to run any time — this just makes sure the
# ITEM SELECTION itself stays honest too, not just the actions inside it.
#
# No manifest entries for a profile (never installed here, or it
# predates install-manifest.jsonl) -> that repo is skipped with a
# pointer to run install.sh yourself once, rather than ever guessing
# --all as a fallback. Deliberately skips the "env" bootstrap repo — it
# has no ITEM_KEYS/--only of its own, and its one symlink (bin/myenv)
# is already in place if this command is running at all.
cmd_link() {
  _require_repos || return 1
  local manifest="$ENVCFG_HOME/install-manifest.jsonl"
  local repo dir items ran=0
  for repo in "${REPOS[@]}"; do
    [[ "$repo" == "env" ]] && continue
    dir="$(repo_dir "$repo")"
    if [[ ! -f "$dir/install.sh" ]]; then
      warn "  ${repo}: no install.sh found — skipping"
      continue
    fi
    if [[ ! -f "$manifest" ]]; then
      warn "  ${repo}: no install-manifest.jsonl under $ENVCFG_HOME — can't tell what was actually installed here. Run 'cd $dir && ./install.sh' yourself once (interactively, or with --only=...) so future 'myenv link' runs know what to re-sync."
      continue
    fi
    items="$(grep -o "\"profile\":\"${repo}\",\"item\":\"[^\"]*\"" "$manifest" | sed -E 's/.*"item":"([^"]*)"/\1/' | sort -u | paste -sd, -)"
    if [[ -z "$items" ]]; then
      warn "  ${repo}: install-manifest.jsonl has no entries for this profile yet — nothing recorded as installed. Run 'cd $dir && ./install.sh' yourself first."
      continue
    fi
    header "== $repo =="
    say "  Re-syncing: $items"
    if ( cd "$dir" && bash install.sh --only="$items" ); then
      say "  ${c_green}Re-synced.${c_reset}"
    else
      warn "  install.sh --only=$items exited non-zero for $repo — see output above."
    fi
    ran=1
  done
  if (( ran == 0 )); then
    say "Nothing to link."
  fi
  say ""
}

# repo_update_options <dir> <branch> [only-branch] -> one option per line,
# "TYPE|TARGET|LABEL" (pipe-delimited — TARGET is a plain branch name,
# never contains a pipe, so this is safe to split on). TYPE is
# "newbranch" (on origin, no local branch yet) or "pending" (a local
# branch, current or not, whose upstream has commits it doesn't have
# yet). This is the ONLY thing cmd_update below shows or acts on —
# deliberately just these three kinds of real state (new branches, new
# tags — folded into a pending branch's label when relevant — and
# branch updates), nothing invented or phrased as a generic "sync to
# origin" action.
repo_update_options() {
  local dir="$1" branch="$2" only="${3:-}"

  if [[ -z "$only" ]]; then
    local -a new_list=()
    _read_lines < <(new_remote_branches "$dir" "$branch")
    new_list=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")
    local nb
    for nb in "${new_list[@]:-}"; do
      [[ -z "$nb" ]] && continue
      printf 'newbranch|%s|NEW - experimental - %s\n' "$nb" "$nb"
    done
  fi

  local -a pend=()
  _read_lines < <(branches_behind "$dir" "$only")
  pend=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")
  local entry b behind upstream_tag current_tag label
  for entry in "${pend[@]:-}"; do
    [[ -z "$entry" ]] && continue
    b="${entry%%:*}"
    behind="${entry##*:}"
    upstream_tag="$(git -C "$dir" describe --tags --abbrev=0 "origin/$b" 2>/dev/null || true)"
    current_tag="$(git -C "$dir" describe --tags --abbrev=0 "$b" 2>/dev/null || true)"
    label="${behind} commit(s) behind origin/${b}"
    [[ -n "$upstream_tag" && "$upstream_tag" != "$current_tag" ]] && label="$label, includes new tag $upstream_tag"
    printf 'pending|%s|%s\n' "$b" "$label"
  done
}

# _apply_update <dir> <current-branch> <target-branch> — the only two
# actions this CLI ever takes on a repo: fast-forward the branch you're
# already on (git merge --ff-only, refuses on its own if it wouldn't be
# a clean fast-forward — can't silently clobber anything), or refresh a
# DIFFERENT local branch's pointer for testing without touching your
# current branch/working tree (git fetch origin b:b — same ff-only
# safety, just via fetch instead of merge since there's no working tree
# to update).
_apply_update() {
  local dir="$1" branch="$2" target="$3"
  if [[ "$target" == "$branch" ]]; then
    if git -C "$dir" merge --ff-only "origin/$target" 2>&1; then
      say "  ${c_green}Updated $target.${c_reset}"
    else
      warn "  Fast-forward failed on $target (local commits diverge?) — resolve manually with git."
    fi
  else
    if git -C "$dir" fetch origin "${target}:${target}" 2>&1; then
      say "  ${c_green}$target refreshed (won't touch your current branch, $branch).${c_reset}"
    else
      warn "  Couldn't fast-forward $target locally — see output above."
    fi
  fi
}

cmd_update() {
  _require_repos || return 1
  local only_branch="${1:-}"

  # Pass 1: fetch every repo, see who actually has anything (no prompts
  # yet) — this is what makes the top-level "update all / select
  # individually" menu possible: it only asks that question once we
  # already know which repos have real updates.
  local -a repos_with_updates=()
  for repo in "${REPOS[@]}"; do
    local dir branch
    dir="$(repo_dir "$repo")"
    if ! git -C "$dir" fetch --quiet 2>/dev/null; then
      warn "  ${repo}: fetch failed — skipping"
      continue
    fi
    branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    local -a opts=()
    _read_lines < <(repo_update_options "$dir" "$branch" "$only_branch")
    opts=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")
    (( ${#opts[@]} > 0 )) && repos_with_updates+=("$repo")
  done

  if (( ${#repos_with_updates[@]} == 0 )); then
    if [[ -n "$only_branch" ]]; then
      say "Nothing pending for '$only_branch' on any repo."
    else
      say "Everything up to date."
    fi
    return 0
  fi

  # Top-level menu — skipped entirely when a specific branch was
  # requested (already scoped) or there's no TTY to ask on (falls back
  # to a read-only listing so this stays script/pipe-safe).
  local mode="select"
  if [[ -z "$only_branch" && -t 0 ]]; then
    say ""
    say "${c_bold}I see updates on: ${repos_with_updates[*]}${c_reset}"
    say "  1) Update all to latest branch/tag"
    say "  2) Select each repo individually"
    read -r -p "Choice [1/2]: " top_choice
    [[ "$top_choice" == "1" ]] && mode="all"
  elif [[ ! -t 0 ]]; then
    say "${c_dim}(no TTY — listing only, nothing applied)${c_reset}"
    mode="list"
  fi

  for repo in "${repos_with_updates[@]}"; do
    local dir branch
    dir="$(repo_dir "$repo")"
    branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    header "== $repo =="
    say "  Current: $branch"

    local -a opts=()
    _read_lines < <(repo_update_options "$dir" "$branch" "$only_branch")
    opts=("${_read_lines_result[@]+"${_read_lines_result[@]}"}")

    local o type rest target label
    case "$mode" in
      list)
        for o in "${opts[@]:-}"; do
          [[ -z "$o" ]] && continue
          type="${o%%|*}"; rest="${o#*|}"; target="${rest%%|*}"; label="${rest#*|}"
          if [[ "$type" == "pending" ]]; then
            say "    - $target: $label"
          else
            say "    - $label"
          fi
        done
        ;;
      all)
        for o in "${opts[@]:-}"; do
          [[ -z "$o" ]] && continue
          type="${o%%|*}"; rest="${o#*|}"; target="${rest%%|*}"; label="${rest#*|}"
          if [[ "$type" == "pending" ]]; then
            _apply_update "$dir" "$branch" "$target"
          else
            say "  ${c_dim}$label (not auto-checked-out)${c_reset}"
          fi
        done
        ;;
      select)
        local i=1
        local -a menu_type=() menu_target=()
        for o in "${opts[@]:-}"; do
          [[ -z "$o" ]] && continue
          type="${o%%|*}"; rest="${o#*|}"; target="${rest%%|*}"; label="${rest#*|}"
          if [[ "$type" == "pending" ]]; then
            say "    [$i] Update $target — $label"
          else
            say "    [$i] $label"
          fi
          menu_type+=("$type"); menu_target+=("$target")
          i=$((i + 1))
        done
        read -r -p "  Choice (number, or Enter to stay on $branch): " reply
        if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#menu_type[@]} )); then
          local idx=$((reply - 1))
          if [[ "${menu_type[$idx]}" == "pending" ]]; then
            _apply_update "$dir" "$branch" "${menu_target[$idx]}"
          elif git -C "$dir" checkout -b "${menu_target[$idx]}" "origin/${menu_target[$idx]}" 2>&1; then
            say "  ${c_green}Checked out ${menu_target[$idx]}${c_reset}"
          else
            warn "  Couldn't check out ${menu_target[$idx]} — see output above."
          fi
        else
          say "  ${c_dim}Staying on $branch.${c_reset}"
        fi
        ;;
    esac
  done
  say ""
}

case "${1:-}" in
  status)  cmd_status ;;
  update)  cmd_update "${2:-}" ;;
  link)    cmd_link ;;
  version) cmd_version ;;
  help | --help | -h | "") usage ;;
  *)
    echo "Unknown subcommand: $1" >&2
    usage
    exit 1
    ;;
esac
