// Zed settings — mirrors the Neovim setup (init.lua) as closely as Zed's
// config model allows. Install to ~/.config/zed/settings.json.
//
// Requires the "Catppuccin" extension installed once from Zed's extension
// panel (cmd-shift-x, search "Catppuccin", install) — Zed doesn't have a
// documented headless/CLI way to install extensions, so that one step has
// to happen inside the app the first time.
{
  "theme": {
    "mode": "dark",
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte"
  },

  // Fonts — same Hack Nerd Font Mono as the terminal/Neovim setup
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_size": 14,
  "ui_font_family": "Hack Nerd Font Mono",
  "ui_font_size": 14,
  "terminal": {
    "font_family": "Hack Nerd Font Mono",
    "font_size": 13,
    "shell": {
      "program": "/bin/zsh"
    },
    "working_directory": "current_project_directory"
  },

  // Vim emulation — Zed's is native (Rust), not an extension like VSCodeVim
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "use_multiline_find": true,
    "toggle_relative_line_numbers": false
  },
  "relative_line_numbers": false,

  // Editing — matches the 2-space indent set across filetypes in init.lua
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "none",
  "cursor_blink": false,
  "scrollbar": {
    "show": "auto"
  },
  "indent_guides": {
    "enabled": true
  },
  "format_on_save": "on",

  // Panels — left project tree ~= nvim-tree, dock behavior similar to
  // the <leader>e toggle in init.lua
  "project_panel": {
    "dock": "left",
    "default_width": 280,
    "git_status": true
  },
  "outline_panel": {
    "dock": "right"
  },

  // Git — inline blame ~= gitsigns' hunk signs/blame in init.lua
  "git": {
    "inline_blame": {
      "enabled": true
    },
    "git_gutter": "tracked_files"
  },

  // Diagnostics/LSP display
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },

  // Per-language overrides — mirrors the ft_indent()/autocmd block at the
  // bottom of init.lua and the Mason server list (gopls, pyright,
  // terraformls, bashls, yamlls, jsonls, dockerls, ansiblels)
  "languages": {
    "Go": {
      "language_servers": ["gopls"],
      "format_on_save": "on"
    },
    "Python": {
      "language_servers": ["pyright"],
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "JSON": {
      "tab_size": 2
    },
    "Terraform": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "Shell Script": {
      "tab_size": 2
    },
    "Dockerfile": {},
    "Markdown": {
      "soft_wrap": "editor_width"
    }
  },

  "lsp": {
    "gopls": {
      "initialization_options": {
        "usePlaceholders": true
      }
    }
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/.terraform",
    "**/__pycache__",
    "**/.DS_Store"
  ]
}
